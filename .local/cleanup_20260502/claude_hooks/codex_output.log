+
 func start() -> void:
 	is_running = true
 	_game_over = false
 	elapsed_time = 0.0
 	_summary_logged = false
+	current_turn = 0
+	_tick_index = 0
+	_final_assault_started = false
+	if _turn_timer != null:
+		_turn_timer.start()
+	if _tick_timer != null:
