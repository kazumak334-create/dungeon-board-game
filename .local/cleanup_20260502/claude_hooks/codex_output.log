 	LogManager.start_battle("001")
 	log_message.emit("Battle started!")
+
+func _setup_timers() -> void:
+	if _turn_timer == null:
+		_turn_timer = Timer.new()
+		_turn_timer.wait_time = TURN_DURATION_SEC
+		_turn_timer.one_shot = false
+		_turn_timer.timeout.connect(_on_turn_timer_timeout)
+		add_child(_turn_timer)
+	if _tick_timer == null:
+		_tick_timer = Timer.new()
+		_tick_timer.wait_time = TICK_INTERVAL_SEC
+		_tick_timer.one_shot = false
+		_tick_timer.timeout.connect(_on_tick_timer_timeout)
+		add_child(_tick_timer)
+
+func _on_turn_timer_timeout() -> void:
+	if not is_running or _game_over or _final_assault_started:
+		return
+	current_turn += 1
+	if deck_manager != null and not deck_manager.force_charge_triggered:
+		var deck_turn: int = current_turn + 1
+		var deck_already_processed: bool = int(deck_manager.current_turn) >= deck_turn and int(deck_manager._last_processed_turn) >= deck_turn
+		deck_manager.current_turn = deck_turn
+		deck_manager._last_processed_turn = deck_turn
+		deck_manager.battle_elapsed_sec = float(current_turn) * TURN_DURATION_SEC
+		if not deck_already_processed:
+			deck_manager.draw_card()
+	print("[EconBattle] turn timer: current_turn=%d elapsed=%.1f" % [current_turn, elapsed_time])
+	_check_force_final_assault()
+
+func _on_tick_timer_timeout() -> void:
+	if not is_running or _game_over or _final_assault_started:
+		return
+	if economy != null:
+		economy.buildings = player_buildings
+		economy.update(_tick_index)
+	print("[EconBattle] tick timer: tick_index=%d elapsed=%.1f" % [_tick_index, elapsed_time])
+	_tick_index += 1
+	_check_force_final_assault()
+
+func _check_force_final_assault() -> void:
+	if _final_assault_started:
+		return
+	if elapsed_time >= NORMAL_PHASE_MAX_SEC or current_turn >= MAX_TURNS:
+		_start_final_assault_phase()
+
+func _start_final_assault_phase() -> void:
+	_final_assault_started = true
+	if _turn_timer != null:
+		_turn_timer.stop()
+	if _tick_timer != null:
+		_tick_timer.stop()
+	if deck_manager != null and not deck_manager.force_charge_triggered:
+		deck_manager.trigger_force_charge()
+	log_message.emit("Final assault phase started")
 
