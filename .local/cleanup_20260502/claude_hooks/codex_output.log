+	if deck_manager != null and not deck_manager.force_charge_triggered:
+		var deck_turn: int = current_turn + 1
+		var deck_already_processed: bool = int(deck_manager.current_turn) >= deck_turn and int(deck_manager._last_processed_turn) >= deck_turn
+		deck_manager.current_turn = deck_turn
+		deck_manager._last_processed_turn = deck_turn
+		deck_manager.battle_elapsed_sec = float(current_turn) * TURN_DURATION_SEC
