+func _check_force_final_assault() -> void:
+	if _final_assault_started:
+		return
+	if elapsed_time >= NORMAL_PHASE_MAX_SEC or current_turn >= MAX_TURNS:
+		_start_final_assault_phase()
+
+func _start_final_assault_phase() -> void:
+	_final_assault_started = true
+	if _turn_timer != null:
+		_turn_timer.stop()
+	if _tick_timer != null:
+		_tick_timer.stop()
+	if deck_manager != null and not deck_manager.force_charge_triggered:
+		deck_manager.trigger_force_charge()
+	log_message.emit("Final assault phase started")
 
