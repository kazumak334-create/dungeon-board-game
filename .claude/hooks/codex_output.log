+	var pool: int = economy.get_work_labor()
+	var active_sites: Array = []
+	for site in sorted_sites:
+		var need: int = int(site.get("required_work_labor", 1))
+		if pool >= need:
+			pool -= need
+			active_sites.append(site)
+	return active_sites
