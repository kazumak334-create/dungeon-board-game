#!/bin/bash
GODOT="/c/Users/kazum/OneDrive/繝・せ繧ｯ繝医ャ繝・繝励Λ繧､繝吶・繝・Godot/Godot_v4.6.2-stable_win64.exe"
PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "=== 讒区枚繝√ぉ繝・け ==="
cd "$PROJECT_DIR"

# Godot --check-only 縺ｧ蜈ｨ繧ｹ繧ｯ繝ｪ繝励ヨ繧偵ヱ繝ｼ繧ｹ
RAW=$(timeout 90 "$GODOT" --path . --headless --check-only 2>&1)

# 繝代・繧ｵ繝ｼ繧ｨ繝ｩ繝ｼ繝ｻ繧ｳ繝ｳ繝代う繝ｫ繧ｨ繝ｩ繝ｼ繧呈歓蜃ｺ
ERRORS=$(echo "$RAW" \
    | grep -iE "Parse[r]? [Ee]rror|Compile [Ee]rror|SCRIPT ERROR|has the same name|Standalone lambda|Cannot be accessed|Expected|Unexpected identifier|Invalid get|Type mismatch|Identifier .* not declared" \
    | grep -vE "RID allocations|Unreferenced static|Thread object|PagedAllocator|GDScript Warning")

ERROR_COUNT=$(echo "$ERRORS" | grep -c . || true)

if [ -n "$ERRORS" ] && [ "$ERROR_COUNT" -gt 0 ]; then
    echo "笶・繝代・繧ｵ繝ｼ繧ｨ繝ｩ繝ｼ ${ERROR_COUNT}莉ｶ:"
    echo "$ERRORS"
    echo ""
    echo "FAILED"
    exit 1
fi
echo "笨・讒区枚繝√ぉ繝・け繝代せ"

# --- grep陬懷ｮ後メ繧ｧ繝・け・・odot縺梧悴繝ｭ繝ｼ繝峨・繧ｹ繧ｯ繝ｪ繝励ヨ繧定｣懷ｮ鯉ｼ・--
echo "=== 髱咏噪繝代ち繝ｼ繝ｳ繝√ぉ繝・け ==="
GREP_ERRORS=0

# 蝙区耳隲悶お繝ｩ繝ｼ竭: var x := ["...", "..."][n] 縺ｯ Variant 繧定ｿ斐＠蝙区耳隲紋ｸ榊庄・医Μ繝・Λ繝ｫ驟榊・繧､繝ｳ繝・ャ繧ｯ繧ｹ・・
INFER=$(grep -rn 'var [A-Za-z_][A-Za-z0-9_]* := \["\|var [A-Za-z_][A-Za-z0-9_]* := .*\]\[' scripts/ 2>/dev/null | grep '\]\[' || true)
if [ -n "$INFER" ]; then
    echo "笶・蝙区耳隲悶お繝ｩ繝ｼ蛟呵｣懌蔵・医Μ繝・Λ繝ｫ驟榊・繧､繝ｳ繝・ャ繧ｯ繧ｹ繝ｻ: 蝙倶ｻ倥￠縺悟ｿ・ｦ・ｼ・"
    echo "$INFER"
    GREP_ERRORS=$((GREP_ERRORS + 1))
fi

# 蝙区耳隲悶お繝ｩ繝ｼ竭｡: var x := array_var[i] 縺ｯ Array 隕∫ｴ縺・Variant 竊・蝙区耳隲紋ｸ榊庄・亥､画焚驟榊・繧､繝ｳ繝・ャ繧ｯ繧ｹ・・
INFER2=$(grep -rn 'var [A-Za-z_][A-Za-z0-9_]* := [a-z_][A-Za-z0-9_]*\[[a-z_]' scripts/ 2>/dev/null || true)
if [ -n "$INFER2" ]; then
    echo "笶・蝙区耳隲悶お繝ｩ繝ｼ蛟呵｣懌贈・亥､画焚驟榊・繧､繝ｳ繝・ャ繧ｯ繧ｹ繝ｻ: 蝙倶ｻ倥￠縺悟ｿ・ｦ・ｼ・"
    echo "$INFER2"
    GREP_ERRORS=$((GREP_ERRORS + 1))
fi

if [ "$GREP_ERRORS" -eq 0 ]; then
    echo "笨・髱咏噪繝代ち繝ｼ繝ｳ繝√ぉ繝・け繝代せ"
else
    echo "FAILED"
    exit 1
fi

# =============================
# [coupling] EconBattle蜀・Κ驟榊・縺ｮ逶ｴ謗･謫堺ｽ懊メ繧ｧ繝・け
# =============================
COUPLING_PATTERNS=(
  "enemy_units\.append"
  "enemy_harvesters\.append"
  "enemy_buildings\.append"
  "player_harvesters\.append"
  "player_buildings\.append"
)
COUPLING_FILES=(
  "scripts/econ_mvp/EconAI.gd"
  "scripts/econ_mvp/EconMain.gd"
)
for pattern in "${COUPLING_PATTERNS[@]}"; do
  for file in "${COUPLING_FILES[@]}"; do
    if [ -f "$file" ] && grep -qn "$pattern" "$file" 2>/dev/null; then
      echo "笶・[coupling] $file 縺ｫ逶ｴ謗･驟榊・謫堺ｽ・ $pattern"
      echo "   竊・spawn/register 繝｡繧ｽ繝・ラ繧剃ｽｿ縺｣縺ｦ縺上□縺輔＞ (EconBattle)"
      ERRORS=$((ERRORS + 1))
    fi
  done
done

echo "=== 螳御ｺ・==="
exit 0

