+			return
+	_show_next_reward()
+
+func _on_reward_skipped(context: Dictionary) -> void:
+	var record := context.duplicate(true)
+	record["selected"] = "SKIP"
+	record["skipped"] = true
+	_reward_manager.record_reward_selection(record)
+	_add_log("蝣ｱ驟ｬ繧ｹ繧ｭ繝・・")
