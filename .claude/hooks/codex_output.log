+func _reindex_construction_queue() -> void:
+	var queue := _get_unbuilt_player_buildings_sorted()
+	for i in range(queue.size()):
+		queue[i].set_meta("construction_order", i + 1)
+	_next_construction_order = queue.size() + 1
