+func generate_land_card_candidates() -> Array:
+	var candidates: Array = []
+	var available_types: Array = ["high_single", "high_composite", "special_tag", "terrain"]
+	available_types.shuffle()
+	for i in range(3):
+		var subtype: String = str(available_types[i])
