+func get_buildable_cells_for_card(_card: Dictionary, own_building_positions: Array, occupied_positions: Array = []) -> Array:
+	var result: Array = []
+	var occupied: Dictionary = {}
+	for pos in occupied_positions:
+		occupied[pos] = true
+	for row in range(ROWS):
