from pathlib import Path
path = Path('data/cards_econ.json')
data = json.loads(path.read_text(encoding='utf-8'))
updates = {
    'card_house': (20, 1, 0, {'wood': 3, 'stone': 0, 'resin': 0}),
    'card_village': (25, 1, 1, {'wood': 4, 'stone': 3, 'wheat': 2}),
    'card_wood_extractor': (25, 1, 1, {'wood': 8, 'stone': 3}),
    'card_stone_extractor': (30, 1, 1, {'stone': 10, 'resin': 4}),
    'card_diner': (25, 1, 1, {'wood': 4, 'stone': 2}),
    'card_barracks': (35, 2, 1, {'wood': 8}),
    'card_plaza': (20, 1, 0, {'wood': 4, 'stone': 2}),
    'card_trade_post': (25, 1, 1, {'wood': 5, 'stone': 5}),
}
for card in data.get('cards', []):
    cid = card.get('id')
    if cid in updates:
        build_time, work_labor, op_labor, cost = updates[cid]
        card['cost'] = cost
        card['build_time'] = build_time
        card['required_work_labor'] = work_labor
        card['required_operation_labor'] = op_labor
        if cid == 'card_wood_extractor':
            card['building_type'] = 'WOOD_EXTRACTOR'
        elif cid == 'card_stone_extractor':
            card['building_type'] = 'STONE_EXTRACTOR'
        elif cid == 'card_trade_post':
            card['category'] = 'special'
            card['building_type'] = 'EXCHANGE'
data['INITIAL_DECK'] = [
