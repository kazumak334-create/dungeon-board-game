+		EconBuilding.BuildingType.BARRACKS, EconBuilding.BuildingType.FORTRESS, EconBuilding.BuildingType.WORKSHOP, EconBuilding.BuildingType.SMITHY, EconBuilding.BuildingType.WATCHTOWER:
+			return 2
