		BuildingType.WATCHTOWER: color = Color(0.3, 0.5, 0.8)  # 繧ｹ繝√・繝ｫ繝悶Ν繝ｼ・磯亟陦幢ｼ・
		BuildingType.DINER: color = Color(0.9, 0.6, 0.2)    # 繧ｪ繝ｬ繝ｳ繧ｸ邉ｻ・磯｣溷ゑｼ・		BuildingType.MILL: color = Color(0.7, 0.8, 0.4)     # 鮟・ｷ醍ｳｻ・郁｣ｽ邊画園・・	color.a = alpha
	draw_rect(Rect2(Vector2(-18, -18), Vector2(36, 36)), color)
