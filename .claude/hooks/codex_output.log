+	return positions
+
+func _get_occupied_positions() -> Array:
+	var positions: Array = []
+	for b in _battle.player_buildings:
+		if b.is_alive:
+			positions.append(b.grid_pos)
+	for h in _battle.player_harvesters:
+		if h.is_alive:
+			positions.append(h.grid_pos)
+	return positions
