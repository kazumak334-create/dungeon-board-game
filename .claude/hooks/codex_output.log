	special_resources = {"sulfur": false}
	wood = 5
	stone = 5
	resin = 5
	wheat = INITIAL_FOOD  # 蠕梧婿莠呈鋤・哘conUnit.gd 縺・economy.wheat 繧貞盾辣ｧ縺吶ｋ縺溘ａ food 縺ｨ蜷梧悄
	food = INITIAL_FOOD
	iron = 5
