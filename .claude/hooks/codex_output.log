+	dim.color = COLOR_PANEL.darkened(0.35)
+	dim.color.a = 0.86
+	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	_difficulty_dialog.add_child(dim)
+	var box := VBoxContainer.new()
+	box.position = Vector2(440.0, 210.0)
