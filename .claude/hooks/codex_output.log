	return 1.0 + get_building_efficiency_modifier()

# 蟷ｸ遖丞ｺｦ縺ｫ繧医ｋ蜈ｵ蜉帷函謌占｣懈ｭ｣菫よ焚・按ｧ2.5.3・・
# "high": 1.1 / "normal"/"dissatisfied": 1.0 / "danger": 0.8
